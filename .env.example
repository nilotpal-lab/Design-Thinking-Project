# ============================================================================
# JainSpace — environment template
#
# Copy to `.env.local` and fill in from your FREE Supabase project:
#   Supabase dashboard → Project Settings → API
#
#   Project URL          → NEXT_PUBLIC_SUPABASE_URL
#   anon / public key    → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role key     → SUPABASE_SERVICE_ROLE_KEY   (server-only)
#
# `.env.local` is gitignored. NEVER commit real keys.
# ============================================================================

# --- Supabase -------------------------------------------------------------
# Safe to expose: shipped to the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# DANGER: bypasses ALL Row Level Security. Server-side only.
# Used by seed/simulation scripts. Never import this into a Client Component,
# never prefix it with NEXT_PUBLIC_, and never log its value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Campus timezone. Must match public.fn_campus_tz() in 0003_views.sql,
# otherwise the UI and the database will disagree about what "now" means.
NEXT_PUBLIC_CAMPUS_TZ=Asia/Kolkata

# Set to 'true' only when seeding a demo environment. Surfaces the
# "demo data" badge for rows flagged is_simulated.
NEXT_PUBLIC_DEMO_MODE=false

# --- Optional: restrict signups to university email ------------------------
# Enforced in the signup Server Action (src/lib/validations.ts).
# Left OFF by default so the project can be demoed with any email.
ALLOWED_EMAIL_DOMAIN=jainuniversity.ac.in
ENFORCE_EMAIL_DOMAIN=false
